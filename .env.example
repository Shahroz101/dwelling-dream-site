# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed - see STRIPE_SETUP.md for where each value comes
# from and how to deploy it.

# Supabase project (Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin panel login (admin.html). If ADMIN_PASSWORD is left blank, the
# server generates a random one on startup and prints it to the logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Stripe (dashboard.stripe.com -> Developers -> API keys).
# Use the test keys (sk_test_...) until you are ready to take real money; the
# storefront reports which mode it is in via /api/config, so a store cannot sit
# in test mode looking operational the way the PayPal sandbox did.
# STRIPE_SECRET_KEY must only ever live here or in the host's env var panel -
# never in frontend code, never committed. Checkout is Stripe-hosted, so the
# browser needs no key at all and no publishable key is required.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...), from Developers -> Webhooks after adding
# the endpoint https://dwellingdream.shop/api/stripe/webhook subscribed to
# checkout.session.completed. This is what proves a webhook really came from
# Stripe; without it the endpoint refuses every request, and orders are then
# only confirmed when the buyer lands back on the order page.
STRIPE_WEBHOOK_SECRET=

# Optional: port the server listens on (defaults to 3000).
PORT=3000

# Outgoing mail (Hostinger SMTP). Without these the order confirmation is
# skipped and the contact form answers 503 - the site still runs, but buyers
# stop receiving their download links, so treat them as required in production.
# SMTP_PASS is the mailbox password from hPanel -> Emails; like every other
# secret here it belongs in Hostinger's Node.js environment variables, not in
# a file inside the deploy directory.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@dwellingdream.shop
SMTP_PASS=
# Optional. Both default to SMTP_USER, which is the only sender Hostinger's
# SMTP will accept for this mailbox.
MAIL_FROM=
CONTACT_TO=
