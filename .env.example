# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed - see PAYPAL_SETUP.md for where each value comes
# from and how to deploy it.

# Supabase project (Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Admin panel login (admin.html). If ADMIN_PASSWORD is left blank, the
# server generates a random one on startup and prints it to the logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PayPal REST API app (developer.paypal.com -> Apps & Credentials).
# PAYPAL_CLIENT_SECRET must only ever live here (or in the host's env var
# panel) - never in frontend code, never committed to git.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "production" to accept real payments.
PAYPAL_ENVIRONMENT=sandbox

# Optional: port the server listens on (defaults to 3000).
PORT=3000
